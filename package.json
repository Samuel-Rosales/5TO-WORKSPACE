{
  "name": "5TO-WORSPASE",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "workspaces": [
    "BACKEND-5TO",
    "FRONTEND-5TO"
  ],
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "scripts": {
    "init": "node scripts/init.js",
    "dev:back": "npm run dev --workspace BACKEND-5TO",
    "dev:front": "npm run dev --workspace FRONTEND-5TO",
    "preview": "npm run preview --workspace FRONTEND-5TO",
    "dev:host": "npm run dev:host --workspace FRONTEND-5TO",
    "dev": "concurrently -n back,front -c blue,green \"npm run dev:back\" \"npm run dev:front\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prisma:generate": "npm run prisma:generate --workspace BACKEND-5TO",
    "prisma:format": "npm run prisma:format --workspace BACKEND-5TO",
    "prisma:push": "npm run prisma:push --workspace BACKEND-5TO",
    "prisma:studio": "npm run prisma:studio --workspace BACKEND-5TO",
    "prisma:seed": "npm run prisma:seed --workspace BACKEND-5TO",
    "prisma:migrate": "npm run prisma:migrate --workspace BACKEND-5TO",
    "db:reset": "npm run db:reset --workspace BACKEND-5TO"
  },
